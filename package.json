{
  "name": "logic-electric-circuit-builder",
  "version": "0.1.7",
  "private": true,
  "description": "Offline electrical and logic schematics for Obsidian.",
  "author": "Hamza",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && node esbuild.config.mjs",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run check:artifacts",
    "lint": "node scripts/lint.mjs && node scripts/obsidian-lint.mjs",
    "preview:build": "node scripts/build-preview.mjs",
    "examples:build": "node scripts/generate-examples.mjs",
    "check:install": "node scripts/smoke-install.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.1",
    "fast-check": "4.10.2",
    "obsidian": "1.14.4",
    "typescript": "7.0.2",
    "vite": "8.1.6",
    "vitest": "4.1.12"
  }
}
